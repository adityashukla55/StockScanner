{
  "name": "stock-scanner",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "description": "A private browser extension for tracking US stocks and ETFs",
  "scripts": {
    "dev": "node scripts/dev-proxy.mjs & vite",
    "build": "vite build",
    "package": "npm run build && node scripts/package.mjs",
    "dev:proxy": "node scripts/dev-proxy.mjs",
    "screenshots": "node scripts/screenshots.mjs ../Stock-Scanner-site/public/shots"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.11"
  }
}
